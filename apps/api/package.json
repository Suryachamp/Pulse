{
  "name": "@pulse/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "build": "tsup",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "postinstall": "prisma generate",
    "db:seed:prod": "node dist/prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@pulse/shared": "workspace:*",
    "argon2": "0.44.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "express": "4.21.2",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prisma": "6.19.3",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.23",
    "@types/node": "22.18.0",
    "@types/supertest": "6.0.3",
    "pino-pretty": "13.1.2",
    "supertest": "7.1.4",
    "tsup": "8.5.0",
    "tsx": "4.20.6",
    "vitest": "3.2.4"
  },
  "files": [
    "dist",
    "prisma"
  ]
}
