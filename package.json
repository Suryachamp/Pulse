{
  "name": "pulse",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "pnpm --parallel --filter @pulse/api --filter @pulse/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @pulse/web test:e2e",
    "db:migrate": "pnpm --filter @pulse/api db:migrate",
    "db:seed": "pnpm --filter @pulse/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  }
}
