# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse
# Exact origin of the web app; state-changing requests from any other origin are rejected.
WEB_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=14
LOG_LEVEL=info
# Number of reverse proxies in front of the API (so rate limiting sees real client IPs).
TRUST_PROXY=0
# Integration tests use a separate database whose name must contain "test".
TEST_DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse_test
