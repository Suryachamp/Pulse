// PULSE data model.
// Every business table carries organizationId. Child records reference their parent
// through a composite (id, organizationId) foreign key so the database itself rejects
// cross-tenant references, not just the application layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  STAFF
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  FULFILLED
  COMPLETED
  CANCELLED
}

enum PaymentKind {
  PAYMENT
  REFUND
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHECK
  OTHER
}

enum MovementType {
  INITIAL
  RESTOCK
  ADJUSTMENT
  RESERVE
  RELEASE
  FULFILL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  LOW_STOCK
  TASK_ASSIGNED
  ORDER_STATUS
  PAYMENT_RECORDED
}

model Organization {
  id                       String   @id @default(uuid()) @db.Uuid
  name                     String
  slug                     String   @unique
  currency                 String   @default("USD") @db.Char(3)
  defaultLowStockThreshold Int      @default(5)
  defaultTaxRateBps        Int      @default(0)
  orderSequence            Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  memberships        Membership[]
  customers          Customer[]
  products           Product[]
  orders             Order[]
  orderItems         OrderItem[]
  payments           Payment[]
  tasks              Task[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  inventoryMovements InventoryMovement[]
  sessions           Session[]
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     Membership[]
  sessions        Session[]
  assignedTasks   Task[]         @relation("TaskAssignee")
  createdTasks    Task[]         @relation("TaskCreator")
  createdOrders   Order[]
  payments        Payment[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  inventoryMoves  InventoryMovement[]
}

model Membership {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  role           Role
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

/// Server-side session. `id` is the SHA-256 of the opaque token stored in the cookie,
/// so a database leak does not yield usable session tokens.
model Session {
  id                   String        @id
  userId               String        @db.Uuid
  activeOrganizationId String?       @db.Uuid
  expiresAt            DateTime
  createdAt            DateTime      @default(now())
  lastSeenAt           DateTime      @default(now())
  userAgent            String?
  ip                   String?
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganization   Organization? @relation(fields: [activeOrganizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  email          String?
  phone          String?
  company        String?
  address        String?
  notes          String?
  tags           String[]     @default([])
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders         Order[]
  tasks          Task[]

  @@unique([id, organizationId])
  @@unique([organizationId, email])
  @@index([organizationId, name])
  @@index([organizationId, createdAt])
}

/// `onHand` is physical stock; `reserved` is held by confirmed orders.
/// Available to sell = onHand - reserved. CHECK constraints (see migration) keep
/// 0 <= reserved <= onHand at the database level.
model Product {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @db.Uuid
  sku               String
  name              String
  description       String?
  priceCents        Int
  costCents         Int?
  onHand            Int          @default(0)
  reserved          Int          @default(0)
  lowStockThreshold Int          @default(5)
  archivedAt        DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
  movements         InventoryMovement[]

  @@unique([id, organizationId])
  @@unique([organizationId, sku])
  @@index([organizationId, name])
}

/// Append-only ledger of every stock change.
model InventoryMovement {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  productId      String       @db.Uuid
  orderId        String?      @db.Uuid
  actorId        String?      @db.Uuid
  type           MovementType
  onHandDelta    Int
  reservedDelta  Int
  onHandAfter    Int
  reservedAfter  Int
  reason         String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Cascade)
  order          Order?       @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: NoAction)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, productId, createdAt])
  @@index([orderId])
}

model Order {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @db.Uuid
  number           Int
  customerId       String       @db.Uuid
  createdById      String?      @db.Uuid
  status           OrderStatus  @default(DRAFT)
  subtotalCents    Int
  discountCents    Int          @default(0)
  taxRateBps       Int          @default(0)
  taxCents         Int          @default(0)
  totalCents       Int
  /// Maintained in the same transaction as each Payment row (under a row lock).
  paidCents        Int          @default(0)
  refundedCents    Int          @default(0)
  notes            String?
  cancelReason     String?
  confirmedAt      DateTime?
  fulfilledAt      DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer         Customer     @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy        User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payments         Payment[]
  movements        InventoryMovement[]
  tasks            Task[]

  @@unique([id, organizationId])
  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerId])
  @@index([organizationId, confirmedAt])
}

/// Price, name and SKU are snapshotted so later catalog edits never rewrite history.
model OrderItem {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  orderId        String       @db.Uuid
  productId      String       @db.Uuid
  productName    String
  sku            String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order        @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  product        Product      @relation(fields: [productId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([organizationId, productId])
}

/// A record of money received or returned. This is tracking only; no gateway is involved.
model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  orderId        String        @db.Uuid
  recordedById   String?       @db.Uuid
  kind           PaymentKind
  method         PaymentMethod
  amountCents    Int
  reference      String?
  note           String?
  idempotencyKey String
  receivedAt     DateTime      @default(now())
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order          Order         @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recordedBy     User?         @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, receivedAt])
  @@index([orderId])
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueAt          DateTime?
  position       Float        @default(0)
  assigneeId     String?      @db.Uuid
  createdById    String?      @db.Uuid
  customerId     String?      @db.Uuid
  orderId        String?      @db.Uuid
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  customer       Customer?    @relation(fields: [customerId, organizationId], references: [id, organizationId], onDelete: NoAction)
  order          Order?       @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: NoAction)

  @@index([organizationId, status, position])
  @@index([organizationId, assigneeId])
  @@index([organizationId, dueAt])
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  type           NotificationType
  title          String
  body           String
  link           String?
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, readAt, createdAt])
}

/// Append-only. A database trigger rejects UPDATE and DELETE (see migration).
model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorId        String?      @db.Uuid
  action         String
  entityType     String
  entityId       String
  summary        String
  metadata       Json         @default("{}")
  ip             String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          User?        @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}
